#!/bin/bash
#
# Cmd-click handler for iTerm2 Semantic History ("Always run command...").
#
# iTerm2 cannot see the folder of a pane in plain tmux. Thus it cannot find a relative path,
# and it opens the text as a web URL (for example http://working/CLAUDE_HANDOFF.md).
# This script finds the file and opens it with the default app (Typora for .md files).
#
# iTerm2 configuration (Settings > Profiles > Advanced > Semantic History):
#   Always run command...   /Users/adam/.local/bin/iterm-open-click \1 \5
#
# Usage: iterm-open-click <clicked text> [iTerm working directory]
#   1. If the text is a URL, the script opens it in the browser.
#   2. If the text is a path, the script looks for the file in these folders, in this sequence:
#      the folder of the active tmux pane (of the focused tmux client on any tmux server),
#      the iTerm working directory, the home folder.
#      It removes a ":line" or ":line:column" suffix.
#   3. If the script finds no file, it shows a macOS notification.
#
# Settings (environment variables, for the tests):
#   ITERM_OPEN_CLICK_OPENER   The command that opens a file or URL. The default is open.
#   ITERM_OPEN_CLICK_TMUX     The tmux command. The default is tmux.

set -uo pipefail

# iTerm2 runs the command with a short PATH. Add the Homebrew folders for tmux.
export PATH="/opt/homebrew/bin:/usr/local/bin:$PATH"

OPENER="${ITERM_OPEN_CLICK_OPENER:-open}"
TMUX_CMD="${ITERM_OPEN_CLICK_TMUX:-tmux}"

text="${1:-}"
shift || true
# iTerm2 can give a working directory with spaces as more than one argument.
iterm_dir="$*"

# Remove quotes, brackets and end punctuation that the click can include.
lead_chars='"'"'"'`<(['
trail_chars='"'"'"'`>)],.;:'
text="${text#["$lead_chars"]}"
text="${text%["$trail_chars"]}"

if [[ -z "$text" ]]; then
  exit 0
fi

# URLs (https://, file://, mailto: and so on) go to the default handler.
if [[ "$text" =~ ^[A-Za-z][A-Za-z0-9+.-]*:// || "$text" =~ ^mailto: ]]; then
  exec "$OPENER" "$text"
fi
if [[ "$text" =~ ^www\. ]]; then
  exec "$OPENER" "https://$text"
fi

# Remove a ":line" or ":line:column" suffix, for example main.go:12:5.
path="$text"
for _ in 1 2; do
  if [[ "$path" =~ ^(.+):[0-9]+$ ]]; then
    path="${BASH_REMATCH[1]}"
  fi
done
if [[ "$path" == "~" || "$path" == "~/"* ]]; then
  path="$HOME${path#\~}"
fi

if [[ "$path" == /* ]]; then
  dirs=("")
else
  # Each iTerm2 tab can have its own tmux server (tmuxattachsession uses "tmux -L <session>").
  # Ask each server for its clients. The tab that you clicked in has the "focused" flag
  # (tmux gets focus events from iTerm2 because ~/.tmux.conf sets focus-events on).
  # If no client has the flag, use the client with the latest activity.
  # Use the folder of the active pane of that client.
  pane_dir=""
  focused_dir=""
  best=-1
  socket_dir="${TMUX_TMPDIR:-/tmp}/tmux-$(id -u)"
  for socket in "$socket_dir"/*; do
    [[ -S "$socket" ]] || continue
    while IFS=$'\t' read -r flags activity dir; do
      if [[ ",$flags," == *",focused,"* ]]; then
        focused_dir=$dir
      fi
      if [[ "$activity" =~ ^[0-9]+$ ]] && ((activity > best)); then
        best=$activity
        pane_dir=$dir
      fi
    done < <("$TMUX_CMD" -S "$socket" list-clients -F $'#{client_flags}\t#{client_activity}\t#{pane_current_path}' 2>/dev/null || true)
  done
  if [[ -n "$focused_dir" ]]; then
    pane_dir=$focused_dir
  fi
  dirs=("$pane_dir" "$iterm_dir" "$HOME")
fi

for dir in "${dirs[@]}"; do
  if [[ -n "$dir" ]]; then
    candidate="$dir/$path"
  else
    candidate="$path"
  fi
  if [[ -e "$candidate" ]]; then
    exec "$OPENER" "$candidate"
  fi
done

osascript -e "display notification \"No file or URL found for: ${text//\"/}\" with title \"iterm-open-click\"" >/dev/null 2>&1
exit 1
