{{- if eq .chezmoi.os "linux" -}}
#!/bin/bash
# Install the user tools on the Linux workspace.
# chezmoi runs this script after it installs the files.
# chezmoi runs it again only when this script or the mise configuration changes.
# mise configuration hash: {{ include "dot_config/mise/config.toml" | sha256sum }}
set -euo pipefail

export PATH="$HOME/.local/bin:$HOME/.local/share/mise/shims:$PATH"

# mise installs Go, kubectl, uv, Python and the other tools in ~/.config/mise/config.toml.
if ! command -v mise > /dev/null; then
  curl -fsSL https://mise.run | sh
fi
mise install --yes

# Python tools. The private repos need the GitHub token from "gh auth login".
python_tools=(
  "git+https://github.com/awilmore/bash-utils.git"
  "git+https://github.com/awilmore/work-utils.git"
  "git+https://github.com/mx51/boto-utils.git"
  "git+https://github.com/mx51/gc-utils.git"
  "git+https://github.com/mx51/py-infra-tools.git"
  "claude-swap"
  "graphifyy[terraform,gemini]"
  "claude-monitor"
)
for tool in "${python_tools[@]}"; do
  uv tool install --force "$tool"
done

# Claude Code, with the native installer
if ! command -v claude > /dev/null; then
  curl -fsSL https://claude.ai/install.sh | bash
fi
{{- end }}
