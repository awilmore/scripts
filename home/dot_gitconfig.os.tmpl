{{- if eq .chezmoi.os "darwin" -}}
# Git settings for macOS. ~/.gitconfig includes this file.

[url "git@github.com:"]
  insteadOf = https://github.com/
{{- else -}}
# Git settings for Linux. ~/.gitconfig includes this file.
# HTTPS URLs use the token from "gh auth login". SSH URLs use ~/.ssh/id_ed25519, which has SSO for mx51.

[credential "https://github.com"]
  helper =
  helper = !/usr/bin/gh auth git-credential

[credential "https://gist.github.com"]
  helper =
  helper = !/usr/bin/gh auth git-credential
{{- end }}
